# Secrets for the Supabase Edge Functions. Never commit the real values.
# Set them with:  supabase secrets set NAME=value   (or in the Supabase dashboard)
# The app's public settings (project URL and publishable key) live in js/config.js.

# Claude API key. Leave unset to run without AI: /agent then answers {ai: false}
# and the app uses its built-in rule-based parser. (Used from M2.)
ANTHROPIC_API_KEY=

# Web Push keys for reminder notifications. (Used from M3.)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
